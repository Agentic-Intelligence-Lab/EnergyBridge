# Copy to the repository root as .env and fill in local values.
# Do not commit .env or any API key.

USE_LLM=true
LLM_PROVIDER=openai_compatible
# Base URL only (normally ending in /v1), not /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<YOUR_API_KEY>
# Optional comma-separated retry/load pool. LLM_API_KEY must still be set.
LLM_API_KEY_POOL=
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3072

# The simulated household uses an independent model/configuration. It may use
# the same endpoint/key/model as the controller, but keep both groups explicit.
ROLEPLAY_USE_LLM=true
ROLEPLAY_LLM_PROVIDER=openai_compatible
ROLEPLAY_LLM_BASE_URL=https://api.openai.com/v1
ROLEPLAY_LLM_API_KEY=<YOUR_API_KEY>
ROLEPLAY_LLM_API_KEY_POOL=
ROLEPLAY_LLM_MODEL=gpt-5.4-mini
ROLEPLAY_LLM_TEMPERATURE=0.7
ROLEPLAY_LLM_MAX_TOKENS=2048

EPLUS_ROOT=/opt/EnergyPlus-24-1-0
ENERGYBRIDGE_HEMA_ROOT=../reference/HEMA

# EnergyBridge V2: observable-profile memory, model-owned control synthesis,
# and LLM role-play consent with baseline-plus-adjustments calibration.
ENERGYBRIDGE_HARNESS_PROFILE=adaptive_v2
ENERGYBRIDGE_VPP_ACCEPTANCE_GATE=adaptive_roleplay_v2
ENERGYBRIDGE_ROLEPLAY_ACCEPTANCE_GATE_USE_LLM=1
ENERGYBRIDGE_PERSIST_AGENT_MEMORY=1

# Harness V2 runs the V3 evidence-profile, causal-memory, and open-portfolio
# planning component schemas. Cross-run memory is a separate, explicit mode:
# set a private file or directory to allow saving, then opt in to loading it.
# Leave both defaults unchanged for reproducible cold-start experiments.
ENERGYBRIDGE_AGENT_MEMORY_STORE=
ENERGYBRIDGE_LOAD_AGENT_MEMORY=0
