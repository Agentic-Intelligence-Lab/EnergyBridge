# Copy to the repository root as .env and fill in local values.
# Do not commit .env or any API key.

USE_LLM=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<YOUR_API_KEY>
LLM_API_KEY_POOL=
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3072

ROLEPLAY_USE_LLM=true
ROLEPLAY_LLM_PROVIDER=openai_compatible
ROLEPLAY_LLM_BASE_URL=https://api.openai.com/v1
ROLEPLAY_LLM_API_KEY=<YOUR_API_KEY>
ROLEPLAY_LLM_API_KEY_POOL=
ROLEPLAY_LLM_MODEL=gpt-5.4-mini
ROLEPLAY_LLM_TEMPERATURE=0.9
ROLEPLAY_LLM_MAX_TOKENS=2048

# The currently validated runtime is EnergyPlus 24.1.0.
EPLUS_ROOT=/opt/EnergyPlus-24-1-0

# External HEMA checkout, pinned as documented in reproducibility/README.md.
ENERGYBRIDGE_HEMA_ROOT=../reference/HEMA

# Historical V1 compatibility profile. The V2 wrappers override these values
# unless ENERGYBRIDGE_HARNESS_PROFILE=paper_v1 is exported before launch.
ENERGYBRIDGE_HARNESS_PROFILE=paper_v1
ENERGYBRIDGE_VPP_ACCEPTANCE_GATE=method_neutral_v1
ENERGYBRIDGE_ROLEPLAY_ACCEPTANCE_GATE_USE_LLM=0
ENERGYBRIDGE_PERSIST_AGENT_MEMORY=0
