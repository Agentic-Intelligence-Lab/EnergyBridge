# Whether to enable LLM calls in optional modules
USE_LLM=false

# Provider can be openai_compatible for now
LLM_PROVIDER=openai_compatible

# OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<YOUR_API_KEY>
# Multiple keys (comma-separated) for automatic rotation under load
LLM_API_KEY_POOL=
LLM_MODEL=gpt-4o-mini

# Generation parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Role-play evaluation user simulator
ROLEPLAY_USE_LLM=false
ROLEPLAY_LLM_PROVIDER=openai_compatible
ROLEPLAY_LLM_BASE_URL=https://api.openai.com/v1
ROLEPLAY_LLM_API_KEY=<YOUR_API_KEY>
ROLEPLAY_LLM_API_KEY_POOL=
ROLEPLAY_LLM_MODEL=gpt-5.4-mini
ROLEPLAY_LLM_TEMPERATURE=0.7
ROLEPLAY_LLM_MAX_TOKENS=2048

# EnergyPlus installation root. Override this in local .env when installed elsewhere.
EPLUS_ROOT=/opt/EnergyPlus-24-1-0

# Harness behavior. For a full API-backed V2 run, use
# reproducibility/v2.env.example instead of this minimal template.
ENERGYBRIDGE_HARNESS_PROFILE=adaptive_v2
ENERGYBRIDGE_VPP_ACCEPTANCE_GATE=adaptive_roleplay_v2
ENERGYBRIDGE_ROLEPLAY_ACCEPTANCE_GATE_USE_LLM=1
ENERGYBRIDGE_PERSIST_AGENT_MEMORY=1
